{
  "name": "3dx-mcp-gateway",
  "version": "0.2.0",
  "description": "NOVA: a private natural-language engineering workspace and governed 3DEXPERIENCE MCP gateway",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts --production",
    "mcp": "node --import tsx server/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "iterop:openapi": "node --import tsx scripts/iterop-openapi.ts",
    "lab:probe": "node --import tsx scripts/lab-probe.ts",
    "iterop:mcp": "node --import tsx server/iterop-mcp.ts",
    "demo:run": "node --import tsx scripts/demo/direct-run.ts .private/demo-run.json",
    "demo:record": "node scripts/demo/record.mjs .private/demo-run.json .private/demo-video"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opedoussaut/3dx-mcp-gateway.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/opedoussaut/3dx-mcp-gateway/issues"
  },
  "homepage": "https://github.com/opedoussaut/3dx-mcp-gateway#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
