# Local, single-operator runtime. Never commit your real .env or private contracts.
PORT=3000
# Complete these only after reviewing the supported API contracts for your release.
NOVA_TENANT_ORIGIN=
NOVA_RELEASE=
NOVA_SECURITY_CONTEXT=
NOVA_CONTRACT_FILE=
# bearer or basic; must match the authentication mechanism verified in the contract.
NOVA_AUTH_MODE=bearer
NOVA_ACCESS_TOKEN=
NOVA_CLIENT_ID=
NOVA_CLIENT_SECRET=
# Optional local intent classifier. The default router needs no model.
NOVA_MODEL_PROVIDER=none
NOVA_MODEL_URL=http://127.0.0.1:11434
NOVA_MODEL_NAME=
# Explicit permission to send mission text to the configured local model.
NOVA_MODEL_EGRESS=false
# MCP is synthetic by default. Set live only with verified private configuration.
NOVA_MCP_SOURCE=synthetic

# --- Business Process (ITEROP) — independent of the engineering connection ---
# Complete only with an approved, documented credential and a reviewed contract.
NOVA_ITEROP_ORIGIN=
NOVA_ITEROP_RELEASE=
NOVA_ITEROP_CONTRACT_FILE=.private/iterop-contract.json
# basic (administrator-issued REST access key/secret) or bearer, exactly as the reviewed contract states.
NOVA_ITEROP_AUTH_MODE=basic
NOVA_ITEROP_ACCESS_KEY=
NOVA_ITEROP_SECRET_KEY=
NOVA_ITEROP_ACCESS_TOKEN=
NOVA_ITEROP_SECURITY_CONTEXT=


# --- Orchestration lab: LIVE sandbox through the API Gateway (synthetic test processes only) ---
# API Gateway origin from the Business Process card's server URL (origin only, no path).
NOVA_LAB_GATEWAY_ORIGIN=
# API Gateway application key (shown once at creation).
NOVA_LAB_API_KEY=
# Openness Agent acting as a non-admin member user (shown once at creation).
NOVA_LAB_AGENT_ID=
NOVA_LAB_AGENT_SECRET=
# Optional: process application origin (e.g. https://<tenant>-eu1-bpa.3dexperience.3ds.com),
# used only for "Open in ITEROP" links in your browser.
NOVA_LAB_PLAY_ORIGIN=
# Reviewed sandbox contract; start from config/lab-contract.template.json.
NOVA_LAB_CONTRACT_FILE=.private/lab-contract.json
# Direct connector (npm run iterop:mcp, docs/iterop/CLAUDE-DIRECT.md): simulated or live.
ITEROP_MCP_ENGINE=simulated
# Who reviews the automated steps: step (an expert confirms each stage) or final (Claude runs
# them; a person validates the result at the ITEROP sign-off).
ITEROP_MCP_REVIEW=step
# Claude (MCP) — see docs/iterop/CLAUDE-MCP.md. Engine the Claude client drives: synthetic or live.
NOVA_LAB_MCP_ENGINE=synthetic
# Where Claude's sandbox writes are approved: portal (a person in NOVA, default) or client
# (the Claude client's own tool-permission prompt).
NOVA_LAB_MCP_APPROVAL=portal
# Local NOVA server the MCP tools call.
NOVA_LAB_URL=http://127.0.0.1:3000
